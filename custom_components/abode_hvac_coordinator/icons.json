{
  "entity": {
    "sensor": {
      "mode": {
        "default": "mdi:home-thermometer",
        "state": {
          "lockout": "mdi:lock",
          "automatic_off": "mdi:hand-back-right",
          "left": "mdi:exit-run",
          "unoccupied": "mdi:home-outline",
          "precool": "mdi:snowflake-alert",
          "sleep": "mdi:sleep",
          "occupied": "mdi:account-check"
        }
      },
      "comfort_index": { "default": "mdi:thermometer-water" },
      "target_temperature": { "default": "mdi:thermometer-check" },
      "commanded_setpoint": { "default": "mdi:thermostat" },
      "dew_point": { "default": "mdi:water-thermometer" },
      "settings": { "default": "mdi:cog" },
      "controller": {
        "default": "mdi:brain",
        "state": { "plan_pid": "mdi:chart-timeline-variant", "rl": "mdi:brain" }
      },
      "learning": { "default": "mdi:school" },
      "comfort_in_band": { "default": "mdi:percent" },
      "near_centre": { "default": "mdi:target" },
      "starts_per_hour": { "default": "mdi:engine" },
      "cost_of_comfort": { "default": "mdi:cash" },
      "demand_forecast": { "default": "mdi:lightning-bolt" },
      "tariff_rate": { "default": "mdi:currency-usd" },
      "constraints": { "default": "mdi:transmission-tower-off" },
      "projected_cost": { "default": "mdi:cash-clock" },
      "outdoor_temperature": { "default": "mdi:thermometer" },
      "outdoor_apparent_temperature": { "default": "mdi:sun-thermometer" },
      "outdoor_dew_point": { "default": "mdi:water-thermometer-outline" },
      "forecast_peak": { "default": "mdi:thermometer-chevron-up" },
      "stale_feeds": { "default": "mdi:timer-sand-paused" },
      "rooms_configured": { "default": "mdi:floor-plan" }
    },
    "switch": {
      "automatic_control": { "default": "mdi:robot", "state": { "off": "mdi:robot-off" } },
      "automatic_vane_control": { "default": "mdi:arrow-oscillating", "state": { "off": "mdi:arrow-oscillating-off" } }
    },
    "select": {
      "comfort_mode": { "default": "mdi:calendar-clock" },
      "unit_mode": { "default": "mdi:hvac" },
      "fan_speed": { "default": "mdi:fan" },
      "vertical_vane": { "default": "mdi:arrow-up-down" },
      "horizontal_vane": { "default": "mdi:arrow-left-right" }
    },
    "number": {
      "setpoint": { "default": "mdi:thermostat" }
    },
    "button": {
      "leave": { "default": "mdi:exit-run" },
      "precool": { "default": "mdi:snowflake" }
    }
  },
  "services": {
    "precool": { "service": "mdi:snowflake" },
    "cancel_precool": { "service": "mdi:snowflake-off" }
  }
}
